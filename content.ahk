}

GetTextNavigationShortcutContent() {
    content := FormatHeader("TEXT NAVIGATION SHORTCUTS")

    content .= "-- Basic Cursor Movement (Arrow Keys) --`n"
    content .= "Up Arrow:                   Move cursor up one line.`n"
    content .= "Down Arrow:                 Move cursor down one line.`n"
    content .= "Left Arrow:                 Move cursor left one character.`n"
    content .= "Right Arrow:                Move cursor right one character.`n`n"

    content .= "-- Word and Paragraph Navigation (Ctrl + Arrow Keys) --`n"
    content .= "Ctrl + Left Arrow:          Move cursor to the beginning of the previous word.`n"
    content .= "Ctrl + Right Arrow:         Move cursor to the beginning of the next word.`n"
    content .= "Ctrl + Up Arrow:            Move cursor to the beginning of the previous paragraph (behavior may vary by application).`n"
    content .= "Ctrl + Down Arrow:          Move cursor to the beginning of the next paragraph (behavior may vary by application).`n`n"

    content .= "-- Navigating to Beginning/End of Line/Document --`n"
