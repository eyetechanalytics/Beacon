GetVoiceAccessShortcutContent() {
    content := FormatHeader("WINDOWS VOICE ACCESS")
    content .= "Windows Voice Access allows you to control your PC and dictate text using your voice.`n"
    content .= "Available in Windows 11 21H2+; substantially enhanced in 23H2, 24H2, and 25H2.`n"
    content .= "Verified as current 2026 (Microsoft).`n`n"
    content .= "-- Starting and Stopping Voice Access --`n"
    content .= "Turn on/off: Search 'Voice Access' in Windows Settings and toggle it on, or use voice command if wake word is enabled.`n"
    content .= "Keyboard Shortcut to toggle listening state: Alt + Shift + C`n"
    content .= "Keyboard Shortcut to open Voice Access flyout: Alt + Shift + B (may vary)`n`n"
    content .= "-- Basic Voice Commands --`n"
    content .= "'Voice access wake up' / 'Unmute': Start listening.`n"
    content .= "'Voice access sleep' / 'Mute': Stop listening but keep Voice Access active.`n"
    content .= "'Turn off microphone': Equivalent to 'Mute'.`n"
    content .= "'Turn off voice access': Closes Voice Access.`n"
    content .= "'What can I say?': Shows a list of available commands.`n"
    content .= "'Show commands for [application name]': Shows app-specific commands.`n"
    content .= "'Show keyboard shortcuts': Shows keyboard related commands.`n`n"
    content .= "-- Mouse and Pointer Control --`n"
    content .= "'Show grid' / 'Mouse grid': Displays a numbered grid to click or move the mouse.`n"
    content .= "  (Then say number(s) to refine, then 'Click' or 'Double click')`n"
    content .= "'Show numbers': Overlays numbers on all clickable items.`n"
    content .= "  (Then say 'Click [number]')`n"
    content .= "'Move mouse [direction] [distance]': e.g., 'Move mouse right 50'`n"
    content .= "'Drag': Starts a drag operation.`n"
    content .= "'Drop': Completes a drag operation.`n"
    content .= "'Scroll [direction]': e.g., 'Scroll down'`n`n"
    content .= "-- Text Dictation and Editing --`n"
    content .= "(Dictate text naturally when in a text field)`n"
    content .= "'Select [text]': Selects the specified text.`n"
    content .= "'Select previous/next [number] words/characters/lines/paragraphs'.`n"
    content .= "'Delete that' / 'Scratch that': Deletes the last dictated phrase.`n"
    content .= "'Delete previous [number] words'.`n"
    content .= "'Backspace' / 'Press backspace'.`n"
    content .= "'Press Enter' / 'Newline'.`n"
    content .= "'Correct [text]': Opens correction menu for specified text.`n"
    content .= "'Spell that': Opens spelling mode for the selected text or last dictation.`n"
    content .= "Punctuation: Say 'Period', 'Comma', 'Question mark', 'Exclamation point', 'Open quotes', 'Close quotes', etc.`n`n"
    content .= "-- Application and Window Control --`n"
    content .= "'Open [application name]': e.g., 'Open Word'`n"
    content .= "'Switch to [application name / window title]'`n"
    content .= "'Close window' / 'Minimize window' / 'Maximize window'`n"
    content .= "'Press Windows key' / 'Press Alt Tab', etc.`n`n"
    content .= "-- Tips --`n"
    content .= "- Requires microphone setup in Windows settings.`n"
    content .= "- Speak clearly. Performance may vary based on microphone quality and background noise.`n"
    content .= "- Check Windows Accessibility settings for Voice Access options and language support.`n"
    content .= "- For the most current list of commands, use the 'What can I say?' command within Voice Access or refer to Microsoft's official documentation.`n`n"
    content .= "-- Voice Access Additions (Windows 11 23H2 / 24H2 / 25H2) --`n"
    content .= "'Create a custom command':     Launches the custom command builder (24H2+)`n"
    content .= "'Open voice access settings':  Direct jump to Voice Access settings`n"
    content .= "'Voice shortcut [name]':       Run a user-defined voice macro (24H2+)`n"
    content .= "'Describe this':               Describe focused image/icon (Copilot+ PC, 24H2+)`n"
    content .= "'Read from here' / 'Stop reading': Text-to-speech playback of document (24H2+)`n"
    content .= "'Enable spelling mode':        Character-by-character dictation`n"
    content .= "'Switch to [English (India) / Spanish / German / French / Japanese / Mandarin]':`n"
    content .= "                               Swap recognition language on the fly (24H2+)`n"
    content .= "'Apply multiple commands':     Chain voice commands in one utterance (25H2)`n`n"
    content .= "-- Keyboard Shortcuts (Voice Access window) --`n"
    content .= "Alt + Shift + C:          Toggle listening (also 'Voice access wake up' / 'sleep')`n"
    content .= "Alt + Shift + B:          Toggle Voice Access on / off`n"
    content .= "Alt + Shift + H:          Open 'What can I say?' help`n`n"
    content .= "-- Verified: 2026 --`n"
    content .= "Covers Voice Access in Windows 11 23H2, 24H2, and 25H2, including custom commands,`n"
    content .= "multilingual voice input, and Copilot+ PC accessibility extensions.`n"
    return content
}

GetMicrosoftDictateContent() {
    content := FormatHeader("MICROSOFT DICTATE (VOICE TYPING) SHORTCUTS")
    content .= "Microsoft Dictate, also known as Windows Voice Typing, allows you to input text using your voice in most text fields.`n`n"
    content .= "-- Starting and Stopping Dictation --`n"
    content .= "Windows key + H: Start or stop voice typing. This opens the dictation bar.`n"
    content .= "Click the Microphone icon: On the dictation bar to toggle dictation on/off.`n`n"
    content .= "-- Basic Commands (while dictation is active) --`n"
    content .= "Say 'Delete that' or 'Scratch that': Deletes the last dictated phrase.`n"
    content .= "Say 'Delete last [number] words': Deletes the specified number of words (e.g., 'Delete last 3 words').`n"
    content .= "Say 'Clear selection': Unselects any selected text.`n"
    content .= "Say 'Select [word or phrase]': Selects the specified word or phrase.`n"
    content .= "Say 'Select last [number] words': Selects the last few words.`n"
    content .= "Say 'Stop dictating' or 'Pause dictation': Pauses dictation (similar to pressing Win + H again).`n`n"
    content .= "-- Punctuation --`n"
    content .= "You can dictate most common punctuation marks by saying their names:`n"
    content .= "  'Period' or 'Full stop' -> .`n"
    content .= "  'Comma' -> ,`n"
    content .= "  'Question mark' -> ?`n"
    content .= "  'Exclamation mark' or 'Exclamation point' -> !`n"
    content .= "  'Newline' or 'New paragraph' -> Starts a new line/paragraph`n"
    content .= "  'Colon' -> :`n"
    content .= "  'Semicolon' -> `;`n"
    content .= "  'Open parenthesis' / 'Close parenthesis' -> ( / )`n"
    content .= "  ...and many others.`n`n"
    content .= "-- Formatting and Editing --`n"
    content .= "Say 'Bold that' / 'Italicize that' / 'Underline that': Applies formatting to the last spoken phrase or selected text.`n"
    content .= "Say 'Uppercase that': Converts the last phrase or selection to uppercase.`n"
    content .= "Say 'Lowercase that': Converts the last phrase or selection to lowercase.`n"
    content .= "Say 'Start list': Begins a bulleted or numbered list (context-dependent).`n"
    content .= "Say 'Next item': Moves to the next item in a list.`n`n"
    content .= "-- Tips for Better Accuracy --`n"
    content .= "- Speak clearly and at a natural pace.`n"
    content .= "- Use a good quality microphone.`n"
    content .= "- Minimize background noise.`n"
    content .= "- Dictate in a quiet environment.`n"
    content .= "- Ensure your language settings in Windows match the language you are speaking.`n`n"
    content .= "For a full list of commands, you can often say 'What can I say?' or check Microsoft's official documentation for Windows Voice Typing.`n"
    return content
}

