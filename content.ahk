    return content
}

GetMicrosoftDictateContent() {
    content := FormatHeader("MICROSOFT DICTATE (VOICE TYPING) SHORTCUTS")
    content .= "Microsoft Dictate, also known as Windows Voice Typing, allows you to input text using your voice in most text fields.`n`n"
    content .= "-- Starting and Stopping Dictation --`n"
    content .= "Windows key + H: Start or stop voice typing. This opens the dictation bar.`n"
    content .= "Click the Microphone icon: On the dictation bar to toggle dictation on/off.`n`n"
    content .= "-- Basic Commands (while dictation is active) --`n"
    content .= "Say 'Delete that' or 'Scratch that': Deletes the last dictated phrase.`n"
    content .= "Say 'Delete last [number] words': Deletes the specified number of words (e.g., 'Delete last 3 words').`n"
    content .= "Say 'Clear selection': Unselects any selected text.`n"
    content .= "Say 'Select [word or phrase]': Selects the specified word or phrase.`n"
    content .= "Say 'Select last [number] words': Selects the last few words.`n"
    content .= "Say 'Stop dictating' or 'Pause dictation': Pauses dictation (similar to pressing Win + H again).`n`n"
    content .= "-- Punctuation --`n"
    content .= "You can dictate most common punctuation marks by saying their names:`n"
    content .= "  'Period' or 'Full stop' -> .`n"
    content .= "  'Comma' -> ,`n"
    content .= "  'Question mark' -> ?`n"
    content .= "  'Exclamation mark' or 'Exclamation point' -> !`n"
    content .= "  'Newline' or 'New paragraph' -> Starts a new line/paragraph`n"
    content .= "  'Colon' -> :`n"
    content .= "  'Semicolon' -> `;`n"
    content .= "  'Open parenthesis' / 'Close parenthesis' -> ( / )`n"
    content .= "  ...and many others.`n`n"
    content .= "-- Formatting and Editing --`n"
    content .= "Say 'Bold that' / 'Italicize that' / 'Underline that': Applies formatting to the last spoken phrase or selected text.`n"
    content .= "Say 'Uppercase that': Converts the last phrase or selection to uppercase.`n"
    content .= "Say 'Lowercase that': Converts the last phrase or selection to lowercase.`n"
    content .= "Say 'Start list': Begins a bulleted or numbered list (context-dependent).`n"
    content .= "Say 'Next item': Moves to the next item in a list.`n`n"
    content .= "-- Tips for Better Accuracy --`n"
    content .= "- Speak clearly and at a natural pace.`n"
    content .= "- Use a good quality microphone.`n"
    content .= "- Minimize background noise.`n"
    content .= "- Dictate in a quiet environment.`n"
    content .= "- Ensure your language settings in Windows match the language you are speaking.`n`n"
    content .= "For a full list of commands, you can often say 'What can I say?' or check Microsoft's official documentation for Windows Voice Typing.`n"
    return content
}

