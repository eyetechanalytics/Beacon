    content .= "Ctrl + F:                   Open Find dialog to search for text.`n"
    content .= "Ctrl + G or F5 (in some apps): Go To a specific line, page, or section.`n"
    content .= "Esc:                        Often used to close dialogs, cancel an action, or deselect text.`n`n"

    content .= "Note: The exact behavior of these shortcuts can sometimes vary slightly between different applications and operating system versions.`n"
    return content
}

GetAppSwitchingShortcutContent() {
