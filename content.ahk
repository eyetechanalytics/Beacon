    content .= "Use arrow keys to navigate suggestions; Tab or number key to accept.`n`n"
    content .= "-- Screenshot Reader Accessibility --`n"
    content .= "F2:                     Activate Screenshot Reader (OCR)`n"
    content .= "After drawing the OCR region, results are pasted to a text box`n"
    content .= "that screen readers can read normally.`n`n"
    content .= "-- Toolbar Accessibility --`n"
    content .= "Alt + Shift + T:        Show/hide Read&Write toolbar`n"
    content .= "Tab / Shift+Tab:        Move between toolbar buttons`n"
    content .= "Enter or Space:         Activate focused toolbar button`n"
    content .= "JAWS and NVDA read toolbar button names as focus moves.`n"
    return content
}

; =============================================================================
;  AT COMBO — MAGIC (general overlay)
