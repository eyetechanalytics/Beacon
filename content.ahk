    content .= "End:                        Move cursor to the end of the current line.`n"
    content .= "Ctrl + Home:                Move cursor to the beginning of the document/text field.`n"
    content .= "Ctrl + End:                 Move cursor to the end of the document/text field.`n`n"

    content .= "-- Page Navigation --`n"
    content .= "Page Up:                    Move cursor up one screen or page.`n"
    content .= "Page Down:                  Move cursor down one screen or page.`n"
    content .= "Ctrl + Page Up:             Move to the top of the previous page (in document views) or previous tab (in some apps).`n"
    content .= "Ctrl + Page Down:           Move to the top of the next page (in document views) or next tab (in some apps).`n`n"

    content .= "-- Text Selection (Shift + Navigation Keys) --`n"
    content .= "Shift + Arrow Key (any):  Extend selection character by character or line by line.`n"
    content .= "Shift + Ctrl + Arrow Key (Left/Right): Extend selection word by word.`n"
    content .= "Shift + Ctrl + Arrow Key (Up/Down): Extend selection paragraph by paragraph (behavior varies).`n"
    content .= "Shift + Home:               Extend selection to the beginning of the current line.`n"
    content .= "Shift + End:                Extend selection to the end of the current line.`n"
    content .= "Shift + Page Up:            Extend selection up one screen.`n"
    content .= "Shift + Page Down:          Extend selection down one screen.`n"
    content .= "Ctrl + Shift + Home:        Extend selection to the beginning of the document/text field.`n"
    content .= "Ctrl + Shift + End:         Extend selection to the end of the document/text field.`n"
    content .= "Ctrl + A:                   Select all text.`n`n"

    content .= "-- F6 Key Navigation --`n"
    content .= "F6:                         Cycle keyboard focus through different panes or sections of an application window (e.g., in web browsers between address bar, bookmarks, page content; in IDEs between editor, project explorer, console).`n"
    content .= "Shift + F6:                 Cycle keyboard focus in the reverse direction through panes/sections.`n"
    content .= "Ctrl + F6:                  In some MDI (Multiple Document Interface) applications (like older Office versions), switch between open documents within that application.`n`n"

    content .= "-- Other Control Key Navigation --`n"
    content .= "Tab:                        Move to the next control, link, or form field. In text editors, may insert a tab character.`n"
