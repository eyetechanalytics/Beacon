GetClipboardShortcutContent() {
    content := FormatHeader("CLIPBOARD KEYBOARD SHORTCUTS")
    content .= "-- Standard Clipboard Operations --`n"
    content .= "Ctrl + C:                         Copy the selected item(s) to the clipboard.`n"
    content .= "Ctrl + X or Shift + Delete: Cut the selected item(s) to the clipboard.`n"
    content .= "Ctrl + V or Shift + Insert: Paste the most recent item from the clipboard.`n"
    content .= "Ctrl + Z:                         Undo the last action (often includes paste).`n"
    content .= "Print Screen (PrtScn):        Copy a screenshot of the entire screen to the clipboard.`n"
    content .= "Alt + Print Screen:             Copy a screenshot of the active window to the clipboard.`n`n"

    content .= "-- Windows Clipboard History (Windows 10 October 2018 Update and later) --`n"
    content .= "Note: Clipboard history must be enabled in Windows Settings (Settings > System > Clipboard).`n`n"
    content .= "Windows key + V:              Open Clipboard History panel. You can then select an item to paste.`n"
    content .= "  - In Clipboard History panel:`n"
    content .= "    - Arrow keys:             Navigate through clipboard items.`n"
    content .= "    - Enter:                  Paste the selected item.`n"
    content .= "    - Delete:                 Delete the selected item from history.`n"
    content .= "    - Tab / Shift + Tab:      Navigate between items and options (e.g., Pin, Clear all).`n"
    content .= "    - P (when item selected): Pin the selected item so it's not removed when history clears or PC restarts.`n"
    content .= "    - C (when item selected, if 'Clear all' is focused): Clear all unpinned items from history.`n`n"

    content .= "-- Snipping Tool / Snip & Sketch --`n"
    content .= "Windows key + Shift + S:    Open Snip & Sketch (or the older Snipping Tool selection UI) to capture a region of your screen to the clipboard.`n"
    content .= "  Options typically include Rectangular Snip, Freeform Snip, Window Snip, and Fullscreen Snip.`n`n"

    content .= "-- Office Clipboard (Microsoft Office Applications) --`n"
